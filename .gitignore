# Dependencies
node_modules/

# Build output
lib/
*.tsbuildinfo

# Test artifacts
.sessions/
coverage/

# Benchmark corpora and generated reports
tests/benchmarks/data/
tests/benchmarks/results/

# Vendored OMP source checkout (recreated by pnpm vendor:init / CI checkout)
vendor/oh-my-pi/upstream/
vendor/oh-my-pi/build/

# Local logs
debug.log
*.log

# Release notes are generated on demand for `gh release create`; never in the tree
.release-notes-*.md
# Root-only: the archived copy under docs/archive/ is tracked
/ORIGIN.md

# OMP reference copy (plan.md methodology: raw material, never committed)
src/tools/_raw_omp/

# Local reference source (refs/oh-my-pi upstream checkout)
refs/

# Local memory store
.dsh-meow/

# 框架自带 skill 的逐字副本（源在 node_modules/e2e/skills/e2e）：本地参考，不进仓库
.agents/skills/

# Python bytecode left behind by one-off tooling
__pycache__/
*.pyc

# e2e 通道：本地密钥。两个名字都挡——用户实际建的是哪个不由我们决定，漏一个就会把真 key 提交上去。
.env
.env.local

# e2e 通道：框架的运行产物（报告、trace、视频、缓存、app 日志）。
.e2e/

# e2e 通道：本次适配流程自己的记录目录（台账、现状记录、报告）。
e2e-adopt/

# Docs stay local (archives/plans/audits, not committed)
docs/*
# ...except README screenshots, which must ship with the repo
!docs/screenshots/
!docs/screenshots/*.png
# Benchmark report linked from the README (must ship so the GitHub link works)
!docs/benchmark/
!docs/benchmark/**
# 自研 shell 命令的实现流程与命令文档（AGENTS.md 直接引用，必须随仓库发布）
!docs/shell-commands/
!docs/shell-commands/**
# Windows 路径方言参考（模型/维护者共用的路径契约，随仓库发布）
!docs/reference/
!docs/reference/**

# 平台包产物（scripts/build-native-packages.mjs 生成，发布时不入库）
dist-natives/
# CI/本地摊包前的 addon 暂存目录（.github/workflows/native.yml 用）
/build/
/dl/
