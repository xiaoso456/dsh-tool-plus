+/// Collapse a shell-resolved executable path before spawning it.
+///
+/// Windows resolves a relative executable name against the *parent* process's
+/// current directory in `CreateProcess`, before the child's `current_dir`
+/// takes effect. The caller passes the path already resolved against the
+/// shell's working directory, so normalizing it here makes the program path
+/// independent of the embedding process's cwd.
+///
+/// Other platforms pass the path through unchanged: the OS resolves it in the
+/// child after `chdir`.
+#[allow(clippy::missing_const_for_fn, reason = "Windows implementation allocates")]
+pub fn normalize_executable_path(path: &Path) -> Cow<'_, Path> {
+	#[cfg(windows)]
+	{
+		use normalize_path::NormalizePath as _;
+
+		Cow::Owned(path.normalize())
+	}
+	#[cfg(not(windows))]
+	{
+		Cow::Borrowed(path)
+	}
+}
