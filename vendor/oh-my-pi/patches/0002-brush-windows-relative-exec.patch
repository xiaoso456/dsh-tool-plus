+	/// Contract: after `cd`, a relative path to an external executable is
+	/// resolved against the shell's working directory, not the host process
+	/// cwd. Windows `CreateProcess` otherwise resolves `./name` against the
+	/// parent process, which is the brush embedding process, not the shell.
+	#[cfg(windows)]
+	#[tokio::test]
+	async fn relative_external_command_resolves_after_cd() {
+		let dir = tempfile::tempdir().unwrap();
+		let sub = dir.path().join("sub");
+		std::fs::create_dir(&sub).unwrap();
+		let system_root =
+			std::env::var_os("SystemRoot").map_or_else(|| PathBuf::from(r"C:\Windows"), PathBuf::from);
+		let source = system_root.join("System32").join("where.exe");
+		let tool = sub.join("relative-exec-probe.exe");
+		std::fs::copy(&source, &tool).unwrap_or_else(|error| {
+			panic!("copy {} to {}: {error}", source.display(), tool.display())
+		});
+
+		let (code, out, err) = run_script("cd sub\n./relative-exec-probe.exe cmd.exe", "", dir.path()).await;
+		assert_eq!(code, 0, "stdout: {out}\nstderr: {err}");
+		assert!(out.to_ascii_lowercase().contains("cmd.exe"), "stdout: {out}");
+	}
 }
 
