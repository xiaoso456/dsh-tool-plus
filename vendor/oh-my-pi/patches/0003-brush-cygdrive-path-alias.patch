+	/// Contract: Cygwin's default `/cygdrive/<drive>` spelling is accepted by
+	/// every path consumer that goes through the shell's absolute-path
+	/// boundary: `cd`, `test`, external commands, and glob expansion.
+	#[cfg(windows)]
+	#[tokio::test]
+	async fn cygwin_drive_alias_is_accepted() {
+		let script = "cd /cygdrive/c/Windows && echo CD_OK\n\
+			pwd\n\
+			test -d /cygdrive/c/Windows && echo TEST_OK\n\
+			/cygdrive/c/Windows/System32/where.exe cmd.exe >/dev/null && echo EXEC_OK\n\
+			set -- /cygdrive/c/Windows/System32/where.*\n\
+			test -e $1 && echo GLOB_OK";
+		let (code, out, err) = run_script(script, "", &std::env::temp_dir()).await;
+		assert_eq!(code, 0, "stdout: {out}\nstderr: {err}");
+		assert!(out.contains("CD_OK"), "stdout: {out}\nstderr: {err}");
+		assert!(out.contains("C:\\Windows"), "stdout: {out}");
+		assert!(out.contains("TEST_OK"), "stdout: {out}\nstderr: {err}");
+		assert!(out.contains("EXEC_OK"), "stdout: {out}\nstderr: {err}");
+		assert!(out.contains("GLOB_OK"), "stdout: {out}\nstderr: {err}");
+	}
 }
 
