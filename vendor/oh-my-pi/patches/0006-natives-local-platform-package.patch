+/**
+ * Directory of the platform package that carries the `.node` for this host.
+ * tool-plus ships its own addon (upstream + the in-process shell builtins) as
+ * `@xiaoso/dsh-tool-plus-natives-<platform>-<arch>`, so that name wins; the
+ * upstream package stays as the fallback for installs without ours, where the
+ * addon simply lacks the extra builtins.
+ */
 function resolveLeafPackageDir(platformTag) {
+	// Two anchors on purpose. Our own platform package is a dependency of the
+	// plugin the loader is bundled into, so it resolves from this module. The
+	// upstream package is an optional dependency of `@oh-my-pi/pi-natives`,
+	// and package managers keep those next to that package's real path, not
+	// next to ours — resolve it from there.
+	const anchors = [createRequire(import.meta.url)];
+	try {
+		anchors.push(createRequire(createRequire(import.meta.url).resolve("@oh-my-pi/pi-natives")));
+	} catch {
+		// pi-natives not installed; only our package can answer
+	}
+	const names = [`@xiaoso/dsh-tool-plus-natives-${platformTag}`, `@oh-my-pi/pi-natives-${platformTag}`];
+	for (const require_ of anchors) {
+		for (const packageName of names) {
+			try {
+				return path.dirname(require_.resolve(`${packageName}/package.json`));
+			} catch {
+				// try the next candidate
+			}
+		}
+	}
+	return null;
+}
