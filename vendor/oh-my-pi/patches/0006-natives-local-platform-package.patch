+/**
+ * Read `version` from the installed `@oh-my-pi/pi-natives` manifest.
+ * A static `import ... from "../package.json"` cannot be used here: this file
+ * is bundled into the consuming plugin, where that relative path resolves to
+ * the plugin's own manifest. The version drives both the per-version cache
+ * directory and the addon release-stamp check, so it must be the real one.
+ */
+function readInstalledPackageVersion() {
 	try {
 		const require_ = createRequire(import.meta.url);
-		return path.dirname(require_.resolve(`@oh-my-pi/pi-natives-${platformTag}/package.json`));
+		const entry = require_.resolve("@oh-my-pi/pi-natives");
+		const manifest = JSON.parse(fs.readFileSync(path.join(path.dirname(entry), "..", "package.json"), "utf8"));
+		return typeof manifest.version === "string" ? manifest.version : null;
 	} catch {
 		return null;
 	}
